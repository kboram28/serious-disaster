# 비밀 정보 (API 키)
.env

# 가상환경
.venv/

# 파이썬 캐시
__pycache__/
*.pyc

# 엑셀 임시 파일 (파일을 열어둘 때 생김)
~$*.xlsx

# 벡터DB 등 다시 만들 수 있는 산출물
vectordb/

# 챗봇 사용자 피드백 (질문 내용 포함)
data/feedback/


# 개인 계획 문서
docs/planning/

# KOSHA GUIDE 원본 PDF (약 460MB, collectors/kosha_guide_pdf.py로 다시 받을 수 있음)
data/raw/kosha_guide/pdf/

# KOSHA GUIDE 추출 텍스트 (약 33MB, pipeline/extract_guides.py로 다시 만들 수 있음)
data/processed/kosha_guide_text.jsonl

# 지침 조각 (약 32MB, pipeline/chunk_guides.py로 다시 만들 수 있음)
data/processed/guide_chunks.csv
# 그림 확인용 PNG (판정 csv만 올림)
data/processed/guide_figures_sample/*.png
